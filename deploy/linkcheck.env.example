# Settings for the weekly link check. Copied to /etc/skilltoincome/linkcheck.env (only root can read it).
# Email is optional: leave SMTP_HOST empty and the check still runs and still updates the website.

# --- Automatic replacement of removed YouTube videos (optional, free) ---
# With a key, a removed video is swapped for the best working video on the same topic and language, and the
# original comes back by itself when it works again. Without a key, students see a YouTube search instead.
# Get a key: console.cloud.google.com -> new project -> "APIs & Services" -> enable "YouTube Data API v3"
#   -> Credentials -> Create credentials -> API key -> "Restrict key" to YouTube Data API v3. Free: 10,000 units/day.
YT_API_KEY=
# Searches per weekly run (each uses 101 units; 40 = about 4,000 units)
MAX_SEARCHES=40

# Your site's public address, used in the email (optional)
SITE_URL=

# --- Email alert (optional) ---
# Oracle Cloud Email Delivery (free tier): SMTP_HOST=smtp.email.<your-region>.oci.oraclecloud.com, port 587,
#   SMTP_USER / SMTP_PASS = the SMTP credentials you generate in the OCI console; MAIL_FROM = an approved sender.
# Gmail also works: SMTP_HOST=smtp.gmail.com, port 587, SMTP_USER=you@gmail.com, SMTP_PASS=an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
